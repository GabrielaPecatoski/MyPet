DATABASE_URL=postgresql://postgres:root@localhost:5433/mypet_auth
JWT_SECRET=mypet_super_secret_change_in_production
RABBITMQ_URL=amqp://mypet:mypet123@localhost:5672
PORT=3001

# Recuperação de senha
# Tempo de validade do código de recuperação (minutos)
PASSWORD_RESET_TTL_MINUTES=30
# Base do link enviado no e-mail (o token é anexado como ?token=...)
APP_RESET_URL=http://localhost/reset-password

# SMTP — se SMTP_HOST não for definido, o e-mail é apenas logado (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyPet <no-reply@mypet.com>
